generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HEAD_OPERATOR
  OPERATOR
  AUDIT
}

enum TaxType {
  TAXA
  BURGHIU
}

enum Currency {
  CLEAN
  DIRTY
  MATERIAL
}

enum Material {
  OTEL
  PRAF
}

enum CashType {
  CLEAN
  DIRTY
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  nickname  String?
  email     String?
  cnp       String?   @db.VarChar(6)
  role      Role      @default(OPERATOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  taxEntries     TaxEntry[]
  drillJobs      DrillJob[]
  invitesCreated Invite[]  @relation("InvitesCreated")
  invitesUsed    Invite[]  @relation("InvitesUsed")
}

model Invite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  role        Role      @default(OPERATOR)
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  createdById Int?
  usedById    Int?

  createdBy   User?     @relation("InvitesCreated", fields: [createdById], references: [id])
  usedBy      User?     @relation("InvitesUsed",   fields: [usedById],   references: [id])
}

model Family {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  colorHex  String

  taxEntries TaxEntry[]
  drillJobs  DrillJob[]
}

model TaxEntry {
  id         Int        @id @default(autoincrement())
  type       TaxType
  currency   Currency?
  material   Material?
  amount     Int
  validUntil DateTime?
  createdAt  DateTime   @default(now())
  cnp        String     @db.VarChar(6)
  payment    String?

  userId   Int?
  familyId Int?

  user     User?    @relation(fields: [userId], references: [id])
  family   Family?  @relation(fields: [familyId], references: [id])

  @@index([cnp, createdAt])
  @@index([validUntil])
}

model DrillJob {
  id        Int       @id @default(autoincrement())
  cnp       String    @db.VarChar(6)
  processed Int
  cadru     Int       @default(0)
  mecanism  Int       @default(0)
  teava     Int       @default(0)
  fixare    Int       @default(0)
  cashType  CashType
  unitPrice Int
  createdAt DateTime  @default(now())

  userId   Int
  familyId Int?

  user     User    @relation(fields: [userId], references: [id])
  family   Family? @relation(fields: [familyId], references: [id])

  @@index([familyId, createdAt])
}
