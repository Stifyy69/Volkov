generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CLEAN
  DIRTY
  FREE
}

enum Material {
  OTEL
  PRAF
}

enum DrillPart {
  CADRU
  TEAVA
  MECANISM
  FIXARE
}

model TaxEntry {
  id         Int      @id @default(autoincrement())
  cnp        String   @db.VarChar(6)
  metoda     PaymentMethod
  amount     Int
  material   Material?
  family     String?
  createdAt  DateTime @default(now())
  validUntil DateTime
}

model DrillJob {
  id        Int      @id @default(autoincrement())
  cnp       String   @db.VarChar(6)
  part      DrillPart
  family    String
  quantity  Int
  createdAt DateTime @default(now())
}
