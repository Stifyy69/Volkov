generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nickname  String?
  email     String?
  cnp       String?  @db.VarChar(6)
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())

  taxEntries TaxEntry[]
  drillJobs  DrillJob[]
  invites    Invite[] @relation("CreatedInvites")
}

model Invite {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  role      Role      @default(OPERATOR)
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  createdById Int?
  usedById   Int?

  createdBy User? @relation("CreatedInvites", fields: [createdById], references: [id])
  usedBy    User? @relation(fields: [usedById], references: [id])
}

model TaxEntry {
  id        Int       @id @default(autoincrement())
  type      TaxType
  currency  Currency?
  material  Material?
  amount    Int
  validUntil DateTime?
  cnp       String    @db.VarChar(6)
  createdAt DateTime  @default(now())
  userId    Int
  familyId  Int?
  payment   String?

  user   User   @relation(fields: [userId], references: [id])
  family Family? @relation(fields: [familyId], references: [id])
}

model DrillJob {
  id        Int       @id @default(autoincrement())
  cnp       String    @db.VarChar(6)
  processed Int
  cadru     Int
  mecanism  Int
  teava     Int
  fixare    Int
  cashType  CashType
  unitPrice Int
  createdAt DateTime  @default(now())
  userId    Int
  familyId  Int?

  user   User   @relation(fields: [userId], references: [id])
  family Family? @relation(fields: [familyId], references: [id])
}

model Family {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  colorHex String
  taxEntries TaxEntry[]
  drillJobs  DrillJob[]
}

enum Role {
  ADMIN
  HEAD_OPERATOR
  OPERATOR
}

enum TaxType {
  TAXA
  BURGHIU
}

enum Currency {
  CLEAN
  DIRTY
  MATERIAL
}

enum Material {
  OTEL
  PRAF
}

enum CashType {
  CLEAN
  DIRTY
}
