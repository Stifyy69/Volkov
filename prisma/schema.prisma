generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HEAD_OPERATOR
  OPERATOR
  AUDIT
}

enum TaxType {
  TAXA       // intrări de taxe (curat / murdar / gratis)
  BURGHIU    // intrări materiale/bucăți (dacă decizi vreodată să le ții aici)
}

enum Currency {
  CLEAN
  DIRTY
  MATERIAL
}

enum Material {
  OTEL
  PRAF
}

enum CashType {
  CLEAN
  DIRTY
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  nickname  String?
  email     String?
  cnp       String?   @db.VarChar(6)
  role      Role      @default(OPERATOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  taxEntries     TaxEntry[]
  drillJobs      DrillJob[]
  invitesCreated Invite[]   @relation("InvitesCreated")
  invitesUsed    Invite[]   @relation("InvitesUsed")
  // Back-relation for Blacklist (required to satisfy Prisma relation validation)
  blacklists     Blacklist[] @relation("UserBlockedBlacklists")

  @@index([username])
  @@index([role])
}

model Invite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  role        Role      @default(OPERATOR)
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  createdById Int?
  usedById    Int?

  createdBy   User?     @relation("InvitesCreated", fields: [createdById], references: [id])
  usedBy      User?     @relation("InvitesUsed",   fields: [usedById],   references: [id])
}

model Family {
  id            Int    @id @default(autoincrement())
  name          String @unique
  colorHex      String

  // Reduceri
  discountDrill Int    @default(0) // % reducere la Burghiu (0..100)
  discountTax   Int    @default(0) // % reducere la Taxe (rezervat pt. viitor)

  taxEntries TaxEntry[]
  drillJobs  DrillJob[]
}

model TaxEntry {
  id         Int        @id @default(autoincrement())

  // Clasificare
  type       TaxType
  currency   Currency?   // CLEAN / DIRTY / MATERIAL (pt. viitor)
  material   Material?   // nefolosit la taxe, rezervat pt. viitor

  // Valori
  amount     Int         // 40000 (curat), 50000 (murdar), 0 (gratis)
  payment    String?     // ex: "DISCOUNTAT"
  cnp        String      @db.VarChar(6)

  // Timp
  createdAt  DateTime    @default(now())
  validUntil DateTime?   // pt. "active (4h)"; NULL = istoric/expirat

  // Legături
  userId     Int?
  familyId   Int?

  user       User?       @relation(fields: [userId], references: [id])
  family     Family?     @relation(fields: [familyId], references: [id])

  @@index([cnp, createdAt])
  @@index([validUntil])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([familyId, createdAt])
}

model DrillJob {
  id        Int       @id @default(autoincrement())

  // Cine / ce
  cnp       String    @db.VarChar(6)
  processed Int
  cadru     Int       @default(0)
  mecanism  Int       @default(0)
  teava     Int       @default(0)
  fixare    Int       @default(0)

  // Bani
  cashType  CashType   // CLEAN/DIRTY
  unitPrice Int        // 1000 etc.

  // Timp
  createdAt DateTime  @default(now())

  // Legături
  userId   Int
  familyId Int?

  user     User    @relation(fields: [userId], references: [id])
  family   Family? @relation(fields: [familyId], references: [id])

  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([createdAt])
}

// ===== BLACKLIST =====
model Blacklist {
  id          Int       @id @default(autoincrement())
  cnp         String
  isBlocked   Boolean   @default(true)
  blockedById Int?
  blockedBy   User?     @relation("UserBlockedBlacklists", fields: [blockedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([cnp])
}
