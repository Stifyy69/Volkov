{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": [
            "npm install"
          ]
        },
        "build": {
          "cmds": [
            "npx prisma generate"
          ]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npx prisma db push && node prisma/seed.js && node src/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
