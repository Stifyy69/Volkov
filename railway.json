{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "install": { "cmds": ["npm install"] },
        "build": {
          "cmds": [
            "npx prisma generate",
            "npx prisma db push",
            "node prisma/seed.js"
          ]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "node backend/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
